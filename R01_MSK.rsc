# ============================================================
# Конфигурация роутера R01.MSK (Москва)
# Лабораторная работа №2 — Статическая маршрутизация
# ============================================================
# Этот роутер находится в московском офисе компании
# "RogalKopita Games". Он соединён с Берлином (R01.BRL)
# через ether1 и с Франкфуртом (R01.FRT) через ether2.
# К ether3 подключены компьютеры сотрудников (PC1).
# ============================================================

# --- Установка имени устройства ---
# Меняем стандартное имя на R01.MSK, чтобы сразу понимать,
# к какому офису относится этот роутер
/system identity set name=R01.MSK

# --- Смена пароля администратора ---
# По умолчанию пароль пустой — это небезопасно.
# Устанавливаем пароль "admin" для пользователя admin
/user set [find name=admin] password=admin

# --- Настройка IP-адресов на интерфейсах ---
# Каждый интерфейс получает свой IP-адрес из своей подсети.
# /30 — маска для линков "точка-точка" (всего 2 хоста)
# /24 — маска для локальной сети офиса (до 254 хостов)
/ip address
add address=10.10.1.1/30 interface=ether1 comment="Канал до Берлина (R01.BRL)"
add address=10.10.2.1/30 interface=ether2 comment="Канал до Франкфурта (R01.FRT)"
add address=192.168.10.1/24 interface=ether3 comment="Локальная сеть офиса Москва"

# --- Настройка DHCP-сервера для локальной сети ---
# DHCP нужен, чтобы ПК сотрудников автоматически получали IP-адреса.
# Шаг 1: Создаём пул адресов (диапазон, из которого будут выдаваться IP)
/ip pool
add name=pool_moscow ranges=192.168.10.10-192.168.10.254

# Шаг 2: Создаём сам DHCP-сервер и привязываем к интерфейсу ether3
/ip dhcp-server
add name=dhcp_moscow interface=ether3 address-pool=pool_moscow disabled=no

# Шаг 3: Указываем параметры сети — шлюз и DNS для клиентов
/ip dhcp-server network
add address=192.168.10.0/24 gateway=192.168.10.1 dns-server=8.8.8.8

# --- Настройка статических маршрутов ---
# Роутер знает только свои прямо подключённые сети.
# Чтобы пакеты доходили до удалённых офисов, нужно вручную
# указать, через какой "следующий шаг" (gateway) их отправлять.

# Маршрут до сети Франкфурта (192.168.20.0/24):
# Отправляем через R01.FRT (10.10.2.2 — его адрес на нашем общем линке)
/ip route
add dst-address=192.168.20.0/24 gateway=10.10.2.2 comment="До сети Франкфурта через R01.FRT"

# Маршрут до сети Берлина (192.168.30.0/24):
# Отправляем через R01.BRL (10.10.1.2 — его адрес на нашем общем линке)
add dst-address=192.168.30.0/24 gateway=10.10.1.2 comment="До сети Берлина через R01.BRL"

# Маршрут до линка Берлин-Франкфурт (10.10.3.0/30):
# Эту сеть мы напрямую не видим, но можем достичь через Берлин
add dst-address=10.10.3.0/30 gateway=10.10.1.2 comment="До линка BRL-FRT через R01.BRL"
